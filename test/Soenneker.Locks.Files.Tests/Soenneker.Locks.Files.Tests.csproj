<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup><PackageReference Include="TUnit" Version="1.75.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Soenneker.Locks.Files\Soenneker.Locks.Files.csproj" />
        <ProjectReference Include="../Soenneker.Locks.Files.TestWorker/Soenneker.Locks.Files.TestWorker.csproj" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <Target Name="CopyTestWorker" AfterTargets="Build">
        <ItemGroup>
            <WorkerFiles Include="../Soenneker.Locks.Files.TestWorker/bin/$(Configuration)/$(TargetFramework)/$(RuntimeIdentifier)/*" />
        </ItemGroup>
        <Copy SourceFiles="@(WorkerFiles)" DestinationFolder="$(OutDir)worker" />
    </Target>
    <Target Name="PublishTestWorker" AfterTargets="Publish">
        <Copy SourceFiles="@(WorkerFiles)" DestinationFolder="$(PublishDir)worker" />
    </Target>
</Project>
